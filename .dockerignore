# The hub image needs sizeup/, data/, pyproject.toml, deploy/hub/, the talkgroup names and the GPU worker's worker.py
# (its hash: the workers' self-update).
.git
.gitignore
.claude/
.venv/
**/__pycache__/
**/*.pyc
*.egg-info/
build/
captures/
state/
models/
cache/
config.toml
*.xlsx
*.sqlite-shm
*.sqlite-wal
tests/
tools/
!tools/stt_worker/worker.py
!tools/stt_worker/pins.json
docs/
deploy/station/
deploy/trunk-recorder/*
!deploy/trunk-recorder/talkgroups.csv
!deploy/trunk-recorder/systems
deploy/hub/*.sqlite*
Dockerfile
.dockerignore
.DS_Store
sizeup/web/static/bundle/
