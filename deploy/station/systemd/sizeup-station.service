# The sizeup station (deploy/station/README.md). Installed by install-linux.sh; edit there, not here.
[Unit]
Description=sizeup station: radios, speech-to-text, forwarding to the hub
Documentation=file:///opt/sizeup/current/deploy/station/README.md
Wants=network-online.target sizeup-whisper.service sizeup-trunk-recorder.service
After=network-online.target systemd-udevd.service
# Never give up restarting (Restart=always below); the health timer also restarts a hung process.
StartLimitIntervalSec=0

[Service]
Type=simple
User=sizeup
Group=sizeup
SupplementaryGroups=plugdev
WorkingDirectory=/opt/sizeup
# Secrets: SIZEUP_STATION_TOKEN, SIZEUP_ACCESS_CLIENT_ID / _SECRET (sizeup-station secrets). Missing:
# the station still runs, records and queues, and its page says what is missing.
EnvironmentFile=-/etc/sizeup/station.env
Environment=HOME=/var/lib/sizeup
Environment=SIZEUP_STATE_DIR=/var/lib/sizeup
# whisper-server is its own service (sizeup-whisper.service): an update doesn't reload the model
Environment=SIZEUP_STT_EXTERNAL=1
# trunk-recorder is its own service too (sizeup-trunk-recorder.service, #71): sizeup hands it the dongle and adopts
# the one that runs, so a restart of this one doesn't drop the P25 control channel
Environment=SIZEUP_TRUNK_RECORDER_UNIT=1
# where the station tells the auto-updater the hub's build (sizeup/cloud/autoupdate.py); kept across
# restarts of this service, gone at a reboot (the hub says it again within a minute)
Environment=SIZEUP_UPDATE_DIR=/run/sizeup
RuntimeDirectory=sizeup
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# The rtl-sdr-blog librtlsdr (V4) and trunk-recorder's plugins first.
Environment=LD_LIBRARY_PATH=/opt/sizeup/rtl-sdr/lib:/opt/sizeup/trunk-recorder/lib/trunk-recorder
Environment=PATH=/opt/sizeup/rtl-sdr/bin:/opt/sizeup/trunk-recorder/bin:/opt/sizeup/whisper/bin:/usr/local/bin:/usr/bin:/bin
# The release /opt/sizeup/current points at, resolved at start (PYTHONPATH, SIZEUP_BUILD): a switch to
# another release takes effect at the next start, never under the running process.
ExecStart=/usr/local/lib/sizeup/start-station
Restart=always
RestartSec=5
# 45 s: a reception test's dongle goes back on its job first (it can wait on the trunk-recorder service, #410),
# then the requests in flight drain (10 s), then the radios stop.
TimeoutStopSec=45
# rtl_fm is its child: stopped and restarted with it (trunk-recorder isn't: sizeup-trunk-recorder.service).
KillMode=control-group
LimitNOFILE=65536
# Ahead of anything else on the box (apt, updates), radios first.
Nice=-5
CPUWeight=500
IOWeight=500
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sizeup-station

[Install]
WantedBy=multi-user.target
