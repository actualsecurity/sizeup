{
  "_about": "Fire chatter as pre-alerts (sizeup/intel/engine.py): what on a fire channel says a job is getting bigger or going wrong, ours or a neighbour's. LOG ONLY: the pack, every category and every rule start at \"log\" (an event in the store and the log; never the map, the console's card or a push) until an admin raises all three in Settings > System > Intel. Scope: every source whose service is fire on the county P25 system and on the analog channels (the firegrounds, the paging channel); never a talkgroup number. A dispatch is no signal here (the CAD has its own incident sources): the rules are escalations and trouble. Generic phrases only: no real addresses, people, callsigns or apparatus numbers; the two villages our department answers are named as the towns of a mutual-aid request. Phrases are written in the spelling of data/intel/tables/stt.json (\"2nd alarm\", \"mayday\", \"standby\"). Each strong phrase family is a rule of its own, at or over the threshold alone, so a later change can mark single rules always-alert. \"Disregard\" is everyday talk on a fire channel and ends nothing here.",
  "name": "fire",
  "version": 1,
  "order": 3,
  "domain": "fire",
  "label": "Fire",
  "scope": {"services": ["fire"], "sources": ["p25:westchester:*", "fm:*"], "tiers": [], "systems": []},
  "accept": false,
  "window_s": 120,
  "threshold": 0.6,
  "context_factor": 0.5,
  "mode": "log",
  "normalize": "stt",
  "infer": false,
  "towns": {},
  "categories": {
    "mayday": {"label": "Fire: mayday / firefighter down", "ttl_min": 60, "priority": 5, "mode": "log", "tag": "sos", "safety": true},
    "evacuate": {"label": "Fire: evacuate / going defensive", "ttl_min": 45, "priority": 5, "mode": "log", "tag": "warning", "safety": true},
    "collapse": {"label": "Fire: collapse", "ttl_min": 60, "priority": 5, "mode": "log", "tag": "warning", "safety": true},
    "trapped": {"label": "Fire: people trapped", "ttl_min": 45, "priority": 5, "mode": "log", "tag": "sos"},
    "working_fire": {"label": "Fire: working fire", "ttl_min": 60, "priority": 4, "mode": "log", "tag": "fire"},
    "more_units": {"label": "Fire: more alarms / units", "ttl_min": 60, "priority": 4, "mode": "log", "tag": "fire_engine"},
    "water_supply": {"label": "Fire: water supply problem", "ttl_min": 45, "priority": 4, "mode": "log", "tag": "droplet"},
    "mutual_aid": {"label": "Fire: mutual aid to or from us", "ttl_min": 60, "priority": 5, "mode": "log", "tag": "handshake"}
  },
  "rules": [
    {"id": "fire.mayday", "v": 1, "category": "mayday", "w": 0.85, "mode": "log",
     "any": ["mayday"], "not": ["mayday (drill|training|class|procedure|procedures)", "no mayday"]},
    {"id": "fire.member_down", "v": 1, "category": "mayday", "w": 0.75, "mode": "log",
     "any": ["(firefighter|firefighters|fireman) (down|trapped|missing|lost|unaccounted|fell through|through the floor)",
             "(member|members) (down|trapped|unaccounted|fell through|through the floor)",
             "(firefighter|member|fireman) ... (out of air|low on air|disoriented|separated|not answering)",
             "(lost|missing) (a|1) (firefighter|member)", "(fast team|rit|rit team|rapid intervention) (activated|activation|deployed|going in|to work)"]},
    {"id": "fire.member_hurt", "v": 1, "category": "mayday", "w": 0.6, "mode": "log",
     "any": ["(firefighter|member|fireman) (injured|hurt|burned)", "(injured|hurt|burned) (firefighter|member|fireman)"],
     "not": ["no (injured|injuries)"]},
    {"id": "fire.urgent_word", "v": 1, "category": "mayday", "w": 0.35, "mode": "log",
     "any": ["(urgent urgent|emergency traffic|emergency transmission)"]},
    {"id": "fire.evacuate", "v": 1, "category": "evacuate", "w": 0.75, "mode": "log",
     "any": ["(evacuate|evacuating|evacuation) (the building|the structure|the interior|the roof)", "(evacuate|evacuating) (all members|all units|everyone|everybody)",
             "all (members|units|companies|personnel|hands) (out|exit|evacuate|back out|out of the building|off the roof)",
             "(everybody|everyone) (out|out of the building|off the roof)", "(back|backing|pull|pulling|get|getting) (everyone|everybody|them|all members) out",
             "(going|switching|switch|go|gone) (defensive|to a defensive|to an exterior)", "(abandon|abandoning) the (building|structure|interior)",
             "(emergency evacuation|evacuation tones|evacuation signal|sound the horns|air horns)"],
     "not": ["evacuation (drill|plan)"]},
    {"id": "fire.evacuate_people", "v": 1, "category": "evacuate", "w": 0.6, "mode": "log",
     "any": ["(evacuate|evacuating|evacuation) ... (residents|occupants|tenants|building|floor|floors|apartments|school|homes)"],
     "not": ["evacuation (drill|plan)", "(has|have|been|already|was|were) evacuated"]},
    {"id": "fire.collapse", "v": 1, "category": "collapse", "w": 0.75, "mode": "log",
     "any": ["(roof|floor|wall|ceiling|partial|structural|building|porch|chimney|stair|stairway) collapse",
             "(roof|floor|ceiling|wall|porch|chimney|stairs|stairway) (collapsed|came down|gave way|is coming down|is sagging)",
             "(building|structure|house) (collapsed|is collapsing|has collapsed|came down)"],
     "not": ["no collapse", "collapse (class|training|drill)"]},
    {"id": "fire.collapse_zone", "v": 1, "category": "collapse", "w": 0.45, "mode": "log",
     "any": ["collapse (zone|potential|hazard|danger)", "(danger|potential|signs) of collapse"]},
    {"id": "fire.people_trapped", "v": 1, "category": "trapped", "w": 0.7, "mode": "log",
     "any": ["(people|persons|person|occupants|occupant|victim|victims|someone|somebody) (trapped|still inside|unaccounted)", "(child|children|residents|resident) (trapped|still inside|unaccounted)",
             "(report|reports) of (people|persons|someone|somebody|occupants|a person|a child|children) (trapped|inside|still inside)",
             "(people|persons|person|occupants|occupant|child|children) (at|hanging out|hanging from) (the|a) (window|windows)",
             "(people|persons|person|occupants|residents|someone) (on the roof|jumping|jumped)", "(victim|victims) (located|found|removed|out)"],
     "not": ["(no one|nobody|no people|no persons|no occupants) (trapped|inside|unaccounted)", "(everyone|everybody|all occupants) (is|are) (out|accounted for)"]},
    {"id": "fire.working", "v": 1, "category": "working_fire", "w": 0.7, "mode": "log",
     "any": ["working fire", "(10 75|1075)", "(fully|well|heavily) involved", "(heavy|working) fire (on|in|showing|throughout|from)",
             "fire (showing|through the roof|venting|blowing out|extending|in the walls|in the attic|in the cockloft|on the 2nd floor)",
             "(heavy|thick|black) smoke (showing|pushing|from|on arrival|throughout)", "(flames|fire) (visible|showing) (from|on|at)",
             "all hands (working|operating|going to work|at work)"],
     "not": ["no fire", "no smoke", "nothing showing", "(burnt|burned) food"]},
    {"id": "fire.extension", "v": 1, "category": "working_fire", "w": 0.45, "mode": "log",
     "any": ["(extension|extending) (to|into) the", "smoke showing", "(fire|smoke) (on|in) the (1st|2nd|3rd|4th|top) floor",
             "(active|visible) fire", "(stretching|stretch|stretched) (a|the|2nd|3rd) (line|lines|hand line)"],
     "not": ["no extension", "no fire", "no smoke", "nothing showing"]},
    {"id": "fire.alarm_level", "v": 1, "category": "more_units", "w": 0.75, "mode": "log",
     "any": ["(2nd|3rd|4th|5th|general) alarm", "(transmit|transmitting|strike|striking|sound|sounding|requesting|request) ... (2nd|3rd|4th|another) alarm",
             "(2|3|4) alarm (fire|assignment)"],
     "not": ["(1st|single) alarm", "no (2nd|additional) alarm"]},
    {"id": "fire.more_units", "v": 1, "category": "more_units", "w": 0.6, "mode": "log",
     "any": ["(additional|another|extra|more|2|3) (engine|engines|ladder|ladders|truck|trucks|tanker|tankers|rescue|alarm|alarms)",
             "(additional|another|extra|more) (units|unit|manpower|companies|company|resources|personnel)",
             "(requesting|request|need|start|send) ... (additional|another|extra|2nd|3rd) (engine|ladder|truck|tanker|rescue)",
             "(special call|special calling)", "tanker (task force|shuttle)", "(requesting|request|need|start|send) ... (fast team|rit team|rapid intervention)"],
     "not": ["no (additional|more|further) (units|unit|engines|manpower|resources|companies)", "(cancel|canceling|cancelling) ... (additional|fast team|special call)"]},
    {"id": "fire.water_lost", "v": 1, "category": "water_supply", "w": 0.7, "mode": "log",
     "any": ["(lost|losing|out of|running out of|low on) (water|pressure|hydrant pressure|our water|the water|supply)",
             "(dead|frozen|bad|broken|dry) hydrant", "hydrant (is|was) (dead|frozen|dry|out of service|broken|no good)",
             "water supply (problem|problems|issue|issues)", "(no|low) (water pressure|hydrant pressure|pressure)",
             "(burst|blown) (length|line|hose|supply line)", "(lost|losing) (the|our) (supply|supply line|hydrant)"],
     "not": ["no water (damage|condition|problem|in the basement)"]},
    {"id": "fire.water_need", "v": 1, "category": "water_supply", "w": 0.5, "mode": "log",
     "any": ["(need|needs|establish|establishing|secure) (a|another|a 2nd|2nd) (water supply|water source|hydrant|supply line)",
             "(need|needs) (water|more water)", "no (hydrant|hydrants) (in the area|nearby|on the street|close)", "(drafting|draft site|set up a draft)"]},
    {"id": "fire.mutual_aid_us", "v": 1, "category": "mutual_aid", "w": 0.75, "mode": "log",
     "any": ["mutual aid ... (port chester|rye brook)", "(port chester|rye brook) ... mutual aid",
             "(port chester|rye brook) ... (to standby|to cover|to relocate|for coverage|for a cover|as the fast team|as fast)",
             "(requesting|request|special call|start|notify|have) ... (port chester|rye brook) ... (fast team|standby|cover|relocate)",
             "(cover|coverage|relocate|relocating|standby) ... (port chester|rye brook) (headquarters|firehouse|station|quarters)"],
     "not": ["(cancel|canceling|cancelling) ... (port chester|rye brook|mutual aid)", "no mutual aid"]},
    {"id": "fire.mutual_aid_word", "v": 1, "category": "mutual_aid", "w": 0.35, "mode": "log",
     "any": ["mutual aid", "(cover assignment|relocate to|relocating to)", "(standby|cover) (at|in) (their|our) (quarters|headquarters|firehouse|station)"],
     "not": ["no mutual aid"]},
    {"id": "fire.request_cue", "v": 1, "category": "*", "w": 0.2, "mode": "log",
     "any": ["(command|ic|incident command) to (60 control|control|dispatch|headquarters)", "(requesting|request) (the|a|an)", "be advised",
             "(on arrival|on scene) ... (we have|i have|with)"]},
    {"id": "fire.urgent_cue", "v": 1, "category": "*", "w": 0.15, "mode": "log",
     "any": ["(rush|expedite|step it up|forthwith)", "(priority|emergency) (traffic|message)", "(multiple|several) (calls|callers)"]},
    {"id": "fire.routine", "v": 1, "category": "routine", "w": -0.4, "mode": "log",
     "any": ["(drill|training|exercise|class)", "(pump|hose|hydrant|radio|pager|tone) (test|testing|check)", "(test|testing) (1|one) (2|two)",
             "(preplan|inspection|walkthrough|walk through)"]},
    {"id": "fire.winding_down", "v": 1, "category": "routine", "w": -0.4, "mode": "log",
     "any": ["under control", "(knocked down|fire is out|fire's out|fire out)", "(overhaul|overhauling|picking up|taking up)",
             "(returning|back in service|available|in quarters)", "(unfounded|false alarm|nothing showing|burnt food|burned food)",
             "(earlier|previous|yesterday|last night|last week)"]}
  ],
  "suppress": ["(this is a drill|this is a test|for training|training exercise|drill only|exercise only)"]
}
