{
  "_about": "County police talkgroups as fire / EMS pre-alerts (sizeup/intel/engine.py). LOG ONLY: the pack, every category and every rule start at \"log\" (an event in the store and the log; never the map, the console's card or a push) until an admin raises all three in Settings > System > Intel. Scope: the county P25 system's talkgroups whose service is police (the talkgroups file's Tag), never a talkgroup number. Generic phrases only: no real addresses, names, callsigns or slang. Phrases are written in the spelling of data/intel/tables/stt.json (\"odor of gas\", \"rollover\", \"en route\"). Each strong phrase family is a rule of its own, at or over the threshold alone, so a later change can mark single rules always-alert; the weaker ones (*_word, *_nature, *_request) only count beside another rule in the window.",
  "name": "county_police",
  "version": 2,
  "order": 1,
  "domain": "police",
  "label": "County PD",
  "scope": {"services": ["police"], "sources": ["p25:westchester:*"], "tiers": [], "systems": []},
  "accept": false,
  "window_s": 120,
  "threshold": 0.6,
  "context_factor": 0.5,
  "mode": "log",
  "normalize": "stt",
  "infer": false,
  "towns": {},
  "area": ["Port Chester", "Rye Brook", "Rye", "Harrison", "Purchase", "West Harrison", "Greenwich", "Byram"],
  "categories": {
    "fire_report": {"label": "PD: smoke / fire", "ttl_min": 45, "priority": 4, "mode": "log", "tag": "fire"},
    "fd_call": {"label": "PD: fire dept requested", "ttl_min": 30, "priority": 4, "mode": "log", "tag": "fire_engine"},
    "alarm": {"label": "PD: fire alarm", "ttl_min": 20, "priority": 2, "mode": "log", "tag": "bell"},
    "hazmat": {"label": "PD: gas / wires / CO", "ttl_min": 60, "priority": 4, "mode": "log", "tag": "biohazard"},
    "aided": {"label": "PD: critical patient", "ttl_min": 30, "priority": 4, "mode": "log", "tag": "ambulance"},
    "ems_call": {"label": "PD: EMS requested", "ttl_min": 30, "priority": 3, "mode": "log", "tag": "ambulance"},
    "mva_injury": {"label": "PD: crash with EMS / injuries", "ttl_min": 45, "priority": 4, "mode": "log", "tag": "car"},
    "water_rescue": {"label": "PD: person / vehicle in water", "ttl_min": 60, "priority": 5, "mode": "log", "tag": "ocean"},
    "rescue": {"label": "PD: elevator / lock-in / trapped", "ttl_min": 45, "priority": 4, "mode": "log", "tag": "sos"},
    "weapons": {"label": "PD: shots / armed", "ttl_min": 90, "priority": 5, "mode": "log", "tag": "warning", "safety": true},
    "barricade": {"label": "PD: barricaded person", "ttl_min": 120, "priority": 5, "mode": "log", "tag": "warning", "safety": true}
  },
  "rules": [
    {"id": "cpd.fire_seen", "v": 2, "category": "fire_report", "w": 0.7, "mode": "log",
     "any": ["smoke ... (from|coming|showing|in the|pouring|inside)", "(heavy|black|thick) smoke", "smoke condition", "(car|vehicle|truck|house|dumpster|brush|kitchen|structure|garage|building) fire", "(engine|electrical|oven|stove|grass|mulch|chimney) fire", "(basement|attic|apartment|transformer|rubbish|garbage|boat|bus|shed|porch|deck) fire", "(flames|fire) (showing|visible|coming)", "(fully|well|heavily) involved", "working fire", "fire in the (building|house|apartment|basement|kitchen|wall|walls|attic|garage)", "(is|it's|was|are) on fire", "(caught|catching) fire", "(building|house|car|vehicle|truck) ... on fire"],
     "not": ["no smoke", "no fire", "smoke detector", "smoke alarm", "fire department (on scene|is on scene)", "(burnt|burned) food", "food on the stove", "fire (is|was) out", "(extinguished|unfounded)", "(not|isn't|wasn't) on fire", "(frying pan|cooking)", "negative fire", "(heater|grill|fireplace|fire pit)"]},
    {"id": "cpd.smell_smoke", "v": 1, "category": "fire_report", "w": 0.45, "mode": "log",
     "any": ["(odor|smell) of smoke", "(odor|smell) of ... burning", "smoke (odor|smell)", "(smells|smelling|smelled) (smoke|something burning|like smoke)", "(sparking|sparks|smoking|smoldering) ... (outlet|wires|wire|car|vehicle|engine|hood|pole|transformer|dumpster)"],
     "not": ["no odor", "no smell"]},
    {"id": "cpd.fd_requested", "v": 2, "category": "fd_call", "w": 0.6, "mode": "log",
     "any": ["(fire department|fd) (en route|responding|notified|requested|on the way|being notified)", "(fire department|fd) (is|are|was|has been|have been) (en route|responding|notified|requested|on the way)", "(notify|notified|start|send|request|requesting|need|get|call) (the fire department|fire department|the fd|fd)", "(notify|start|send|requesting|need) fire", "fire (notified|is notified|en route|is en route|is responding|was notified)", "(have|having) (the fire department|fire|the fd) (respond|come|check|step it up)", "(fire department|fd) (is|are) being (dispatched|sent)", "(fire department|fd) (dispatched|being dispatched|sent)", "fire control (called|is sending|advised|notified)"],
     "not": ["fire department (on scene|is on scene|cleared|is clear|not needed)", "(cancel|canceling|cancelling) (the fire department|fire|fd)", "(don't|do not) need (the fire department|fire|fd)"]},
    {"id": "cpd.fire_alarm", "v": 1, "category": "alarm", "w": 0.6, "mode": "log",
     "any": ["(fire alarm|smoke alarm|smoke detector) ... (activation|activated|sounding|going off|ringing)", "(commercial|residential|automatic|general) fire alarm", "(waterflow|sprinkler|pull station) (alarm|activation)", "for (a|the) fire alarm", "fire alarm (at|in|on|activation|sounding)", "alarm ... (sounding|going off) ... fire (notified|department|en route|responding)"],
     "not": ["(test|testing|tested) ... (fire alarm|alarm)", "alarm company (is testing|testing|test)", "fire alarm (test|testing|drill)"]},
    {"id": "cpd.fire_alarm_word", "v": 2, "category": "alarm", "w": 0.4, "mode": "log",
     "any": ["fire alarm", "(smoke|co|carbon monoxide) (alarm|detector)"],
     "not": ["fire alarm (test|testing|drill)", "low battery", "(chirp|chirping|beeping)"]},
    {"id": "cpd.gas", "v": 2, "category": "hazmat", "w": 0.65, "mode": "log",
     "any": ["(odor|smell) of (gas|natural gas|propane|gasoline|fuel)", "(gas|propane) (leak|odor|smell)", "(smell|smells|smelling|smelled) (gas|like gas)", "(struck|hit|ruptured|broken|open|leaking) gas (line|main|meter)", "gas (line|main|meter) ... (struck|hit|ruptured|broken|leaking|break)"],
     "not": ["no odor", "no smell", "no gas", "gas station", "gas (truck|crew|company|station|meter reader|meter reading)", "national grid", "utility crew"]},
    {"id": "cpd.spill", "v": 1, "category": "hazmat", "w": 0.45, "mode": "log",
     "any": ["(fuel|gasoline|oil|diesel|chemical|fluid|fluids) (spill|leak|leaking|spilled)", "leaking (fuel|gasoline|gas|oil|diesel|fluids)"]},
    {"id": "cpd.wires", "v": 1, "category": "hazmat", "w": 0.6, "mode": "log",
     "any": ["(wires|wire|power lines|primary|primaries) ... (down|arcing|sparking|burning|smoking)", "(transformer|utility pole|pole) ... (fire|explosion|exploded|blew|arcing|sparking|burning)", "tree ... (on|into|onto) (wires|the wires|a house|the house|power lines|a car)", "(live|downed) (wires|wire|power lines)"],
     "not": ["(cable|phone|telephone) (wire|wires|line|lines)", "no wires"]},
    {"id": "cpd.co", "v": 3, "category": "hazmat", "w": 0.6, "mode": "log",
     "any": ["(carbon monoxide|co) (alarm|detector) ... (activation|activated|sounding|going off)", "carbon monoxide", "co ... (symptoms|sick|headache|headaches|dizzy|nausea)", "(residential|commercial) co alarm", "for (a|the) co alarm", "co alarm (at|in|on|activation|sounding)"],
     "not": ["no symptoms", "low battery", "(chirp|chirping|beeping)"]},
    {"id": "cpd.cpr", "v": 1, "category": "aided", "w": 0.75, "mode": "log",
     "any": ["cpr in progress", "(starting|started|doing|performing|administering|begin|beginning) cpr", "cpr", "not breathing", "(isn't|stopped|wasn't) breathing", "cardiac arrest", "(no pulse|pulseless)", "(aed|defibrillator)"],
     "not": ["cpr (class|training|course|certified)", "(is|now|and) breathing"]},
    {"id": "cpd.unresponsive", "v": 2, "category": "aided", "w": 0.65, "mode": "log",
     "any": ["(unresponsive|unconscious)", "(down|collapsed) and not moving", "(person|male|female|man|woman|party|driver) (down|collapsed) (on|in|at|inside)", "(passed out|slumped over|slumped at the wheel|not responsive|not waking up)"],
     "not": ["conscious and (alert|breathing)", "(is|now) (responsive|conscious|awake)", "(now|is) alert", "alert and (conscious|oriented)", "conscious and alert"]},
    {"id": "cpd.overdose", "v": 2, "category": "aided", "w": 0.6, "mode": "log",
     "any": ["(overdose|overdosed|overdosing)", "narcan", "(possible|apparent|suspected) od"],
     "not": ["(overdose|od) is negative", "negative (overdose|od)", "not (an|a) overdose"]},
    {"id": "cpd.ems_request", "v": 2, "category": "ems_call", "w": 0.6, "mode": "log",
     "any": ["(ems|ambulance|medics|medic|paramedics|als|bls) (en route|responding|requested|needed|notified|on the way|to respond)", "(ems|ambulance|medics|paramedics) (is|are|was|has been) (en route|responding|requested|notified|on the way)", "(need|needs|requesting|request|send|start|get|notify) (ems|an ambulance|the ambulance|medics|a medic|paramedics|als)", "(ems|ambulance|medics|als) (to|for) (the|a|an|that)", "(have|having) (ems|an ambulance|the ambulance|medics) (respond|come|check|step it up)", "(ems|ambulance|medics|paramedics) (is|are) (being sent|being dispatched|going to be|coming|aware)", "(ems|ambulance|medics) (dispatched|sent|being sent|being dispatched)", "(ems|ambulance) for dispatch", "(request|requesting) for (ems|an ambulance|the ambulance|medics)"],
     "not": ["(cancel|canceling|cancelling) (ems|the ambulance|medics|als)", "(refused|refusing|refusal|rma)", "no (ems|ambulance)", "(don't|do not|doesn't) need (ems|an ambulance|the ambulance)", "(ems|ambulance) (anymore|any more)", "(don't|do not|doesn't) need (ems|an ambulance|the ambulance|medics)", "(ems|ambulance|medics) (cancelled|canceled|not needed|is not needed)"]},
    {"id": "cpd.medical_nature", "v": 3, "category": "ems_call", "w": 0.5, "mode": "log",
     "any": ["(seizure|seizures|seizing)", "(chest pain|chest pains)", "(difficulty|trouble) breathing", "shortness of breath", "(heavy|severe|uncontrolled) bleeding", "(head injury|laceration|allergic reaction|choking|diabetic|stroke)", "(fell|fall|fallen) ... (injury|injured|hip|head|bleeding|get up)", "(medical alarm|medical alert|medical emergency|life alert)", "aided (case|call)", "not feeling well", "heart (condition|problem|problems|attack)", "(fainted|fainting|syncope|lethargic|vomiting|dizzy|dizziness)", "(passing|passed) out", "(asthma|overdose|unconscious|unresponsive)", "(injured|injuries) from a fall", "(sick|ill|injured|intoxicated) (person|male|female|party|child|subject|man|woman)"]},
    {"id": "cpd.patient_age", "v": 1, "category": "ems_call", "w": 0.3, "mode": "log",
     "any": ["year old (male|female|man|woman|child|boy|girl)", "for (a|an|the) (patient|aided)", "(elderly|adult) (male|female|man|woman)"]},
    {"id": "cpd.mva_serious", "v": 2, "category": "mva_injury", "w": 0.7, "mode": "log",
     "any": ["(rollover|overturned|rolled over|on its side|on its roof|head on)", "(pedestrian|ped|bicyclist|cyclist|pedestrians) (struck|hit)", "(struck|hit) (a|the) (pedestrian|bicyclist|cyclist)", "(struck|hit) by (a|the) (car|vehicle|truck|bus|train)", "(entrapment|extrication|ejected|ejection)", "(pinned|trapped) ... (vehicle|car|truck|driver|passenger|dashboard)", "(car|vehicle|truck|bus) (into|through|struck|hit) (a|the) (building|house|store|storefront|pole|tree|wall)"],
     "not": ["no injuries", "no injury", "property damage only", "no entrapment", "(deer|animal|dog|coyote|raccoon) ... (struck|hit)", "(struck|hit) (a|the) (deer|animal|dog|coyote|raccoon)", "(deer|animal|dog|coyote|raccoon) (that|which) was (struck|hit)"]},
    {"id": "cpd.mva_injury", "v": 2, "category": "mva_injury", "w": 0.65, "mode": "log",
     "any": ["(mva|accident|crash|collision) ... (injury|injuries|injured)", "(injury|injuries|injured) ... (accident|crash|mva|collision)", "personal injury", "pia", "(airbag|airbags) (deployed|deployment)"],
     "not": ["no injuries", "no injury", "property damage only", "(unknown|unknown if) (injury|injuries)", "any injuries", "(negative|without) (injury|injuries)"]},
    {"id": "cpd.pursuit_crash", "v": 1, "category": "mva_injury", "w": 0.65, "mode": "log",
     "any": ["(pursuit|chase) ... (crashed|crash|accident|collision|struck|hit)", "(crashed|wrecked|crash) ... (pursuit|chase)", "(suspect|fleeing|subject) vehicle (crashed|struck|hit|overturned|rollover)"],
     "not": ["no injuries", "no injury"]},
    {"id": "cpd.mva_word", "v": 1, "category": "mva_injury", "w": 0.35, "mode": "log",
     "any": ["(mva|motor vehicle accident|car accident|vehicle accident|crash|collision)", "(2|3|4|multi|multiple) (car|vehicle) accident"],
     "not": ["no injuries", "no injury", "property damage only"]},
    {"id": "cpd.mva_ems", "v": 1, "category": "mva_injury", "w": 0.45, "mode": "log",
     "any": ["(ems|ambulance|medics|medic|paramedics|als|bls) (en route|responding|requested|needed|notified|on the way|to respond)", "(need|needs|requesting|request|send|start|get|notify) (ems|an ambulance|the ambulance|medics|a medic|paramedics|als)", "(ems|ambulance|medics|als) (to|for) (the|a|an|that)", "(transported|transporting|transport) ... (hospital|medical center)", "(precautionary|evaluation|evaluated)"],
     "not": ["(cancel|canceling|cancelling) (ems|the ambulance|medics|als)", "(refused|refusing|refusal|rma)", "no (ems|ambulance)"]},
    {"id": "cpd.water", "v": 1, "category": "water_rescue", "w": 0.7, "mode": "log",
     "any": ["(person|subject|male|female|someone|somebody|child|kid|body|man|woman) in the (water|river|pond|lake|sound|harbor)", "(person|subject|male|female|someone|somebody|child|kid|body|man|woman) in the (pool|creek|brook|reservoir)", "(car|vehicle|truck) (in|into) the (water|river|pond|lake|sound|harbor|creek|brook|reservoir)", "(car|vehicle|truck) ... (submerged|into the water|in the water)", "(boat|vessel|kayak|canoe) (sinking|taking on water|capsized|overturned|adrift)", "through the ice", "(drowning|drowned|went under|gone under)", "(fell|jumped|went|drove) (in|into) the (water|river|pond|lake|sound|harbor|creek|brook)"],
     "not": ["(no one|no 1|nobody) in the water", "out of the water"]},
    {"id": "cpd.elevator", "v": 1, "category": "rescue", "w": 0.6, "mode": "log",
     "any": ["(stuck|trapped|stalled) ... elevator", "elevator ... (stuck|trapped|stalled|entrapment|occupied|occupants|inside)", "elevator (rescue|entrapment|emergency)"],
     "not": ["(unoccupied|empty)", "(no one|no 1|nobody|no occupants) ... (inside|elevator)"]},
    {"id": "cpd.lock_in", "v": 1, "category": "rescue", "w": 0.6, "mode": "log",
     "any": ["(child|baby|infant|kid|toddler|year old) ... locked (in|inside)", "locked (in|inside) ... (child|baby|infant|kid|toddler|year old)", "lock in ... (child|baby|infant|kid|toddler|year old)", "(child|baby|infant|kid|toddler|year old) ... lock in"]},
    {"id": "cpd.trapped", "v": 1, "category": "rescue", "w": 0.6, "mode": "log",
     "any": ["(trapped|pinned|stuck) (under|underneath|beneath|between|in a trench|in the trench|in a machine|in the machine)", "(trench|building|scaffold|scaffolding|roof|ceiling|wall|deck|floor|porch) collapse", "(roof|ceiling|wall|deck|floor|porch) collapsed"]},
    {"id": "cpd.shots", "v": 2, "category": "weapons", "w": 0.75, "mode": "log",
     "any": ["shots fired", "(shot|shots) ... heard", "(gunshot|gunshots)", "(man|male|female|subject|person) with a (gun|knife|weapon|handgun|rifle)", "person shot", "(stabbing|stabbed)", "(man|male|female|subject|person|suspect) armed with (a|an) (gun|knife|weapon|handgun|rifle|pistol)"],
     "not": ["no weapons", "fireworks", "no shots"]},
    {"id": "cpd.armed", "v": 3, "category": "weapons", "w": 0.5, "mode": "log",
     "any": ["(gun|firearm|knife|handgun|rifle) ... (seen|displayed|involved|pointed)", "(is|are|possibly|be) armed", "(armed|brandishing) (male|female|subject|person|suspect|man|woman|robbery|party)", "(armed|brandishing) with (a|an) (gun|knife|weapon|handgun|rifle|firearm|bat|machete|pistol)"],
     "not": ["no weapons", "not armed", "unarmed"]},
    {"id": "cpd.barricade", "v": 1, "category": "barricade", "w": 0.7, "mode": "log",
     "any": ["(barricaded|barricade) (subject|person|male|female|suspect|himself|herself|inside|situation|juvenile)", "(barricaded|locked) (himself|herself|themselves) (in|inside)", "(hostage|hostages)", "refusing to (come out|exit)"]},
    {"id": "cpd.barricade_word", "v": 1, "category": "barricade", "w": 0.35, "mode": "log",
     "any": ["(barricaded|barricade)"],
     "not": ["(barricade|barricades) (up|down|set up|in place|across)", "(road|street|traffic|wooden|police) (barricade|barricades)"]},
    {"id": "cpd.dispatch_cue", "v": 1, "category": "*", "w": 0.2, "mode": "log",
     "any": ["respond to", "(vicinity|area) of", "report of", "caller (states|reports|advising|says)", "(check|investigate) ... for"]},
    {"id": "cpd.urgent_cue", "v": 1, "category": "*", "w": 0.15, "mode": "log",
     "any": ["(priority|emergency) (call|response)", "(rush|expedite|step it up)", "(multiple|several) (calls|callers)"]},
    {"id": "cpd.routine", "v": 1, "category": "routine", "w": -0.4, "mode": "log",
     "any": ["(traffic stop|parking complaint|noise complaint)", "(lockout|car lockout)", "(test|testing) (1|one) (2|two)", "(drill|exercise) only"]},
    {"id": "cpd.resolved", "v": 1, "category": "routine", "w": -0.5, "mode": "log",
     "any": ["(unfounded|negative results|gone on arrival|goa)", "false alarm", "(burnt|burned) food", "under control", "(refused|refusing) (medical|attention|aid|ems|treatment)", "(rma|patient refusal)", "no (ems|ambulance) needed", "(cancel|canceling|cancelling) (ems|the ambulance|fire|the fire department|fd)", "(earlier|previous|yesterday|last night|last week)"]}
  ],
  "suppress": ["(disregard|disregarding)", "cancel (that|the call|the response)", "(training|this is a test|for training)"]
}
