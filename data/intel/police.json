{
  "_about": "Police dispatch pre-alerts (sizeup/intel/engine.py). Generic phrases only: no real addresses, names, callsigns or slang (those live in the hub's Settings, never in this public file). Every category pushes to the pre-alert topic from day one (user, 2026-11-12: no shadow week); Settings > System > Intel moves any rule, category or the pack down the ladder off / shadow / log / map / push.",
  "name": "police",
  "version": 1,
  "domain": "police",
  "label": "PD",
  "scope": {"services": ["police"], "sources": ["p25:mrrs:*"], "tiers": [], "systems": ["mrrs"]},
  "accept": false,
  "window_s": 120,
  "threshold": 0.6,
  "context_factor": 0.5,
  "mode": "push",
  "towns": {"p25:mrrs:9211": ["Port Chester", "Rye", "Rye Brook"]},
  "categories": {
    "fire_report": {"label": "Smoke / fire reported", "ttl_min": 45, "priority": 4, "mode": "push", "tag": "fire"},
    "weapons": {"label": "Weapon / shots", "ttl_min": 90, "priority": 5, "mode": "push", "tag": "warning", "safety": true},
    "mva_injury": {"label": "MVA with injuries", "ttl_min": 45, "priority": 4, "mode": "push", "tag": "car"},
    "barricade": {"label": "Barricade", "ttl_min": 120, "priority": 5, "mode": "push", "tag": "warning", "safety": true},
    "aided": {"label": "Aided / unresponsive", "ttl_min": 30, "priority": 4, "mode": "push", "tag": "ambulance"},
    "hazmat": {"label": "Gas / hazmat", "ttl_min": 60, "priority": 4, "mode": "push", "tag": "biohazard"},
    "water_rescue": {"label": "Water rescue", "ttl_min": 60, "priority": 5, "mode": "push", "tag": "ocean"},
    "pursuit": {"label": "Pursuit", "ttl_min": 20, "priority": 3, "mode": "push", "tag": "rotating_light", "moves": true},
    "edp": {"label": "EDP", "ttl_min": 60, "priority": 3, "mode": "push", "tag": "warning", "safety": true},
    "dispute": {"label": "Dispute / fight", "ttl_min": 30, "priority": 3, "mode": "push", "tag": "rotating_light", "safety": true},
    "alarm": {"label": "Alarm", "ttl_min": 20, "priority": 2, "mode": "push", "tag": "bell"}
  },
  "rules": [
    {"id": "pd.smoke_seen", "v": 1, "category": "fire_report", "w": 0.7,
     "any": ["smoke ... (from|coming|showing|in the|pouring)", "(car|vehicle|house|dumpster|brush|kitchen|structure|garage) fire", "(flames|fire) (showing|visible|coming)", "fire in the (building|house|apartment|basement)"],
     "not": ["no smoke", "smoke detector", "smoke alarm", "fire department (on scene|is on scene)"]},
    {"id": "pd.smell_smoke", "v": 1, "category": "fire_report", "w": 0.45,
     "any": ["(odor|smell) of smoke", "(odor|smell) ... burning"], "not": ["no odor"]},
    {"id": "pd.shots", "v": 1, "category": "weapons", "w": 0.75,
     "any": ["shots fired", "(shot|shots) ... heard", "(gunshot|gunshots)", "(man|male|female|subject) with a (gun|knife|weapon)", "person shot", "(stabbing|stabbed)"],
     "not": ["no weapons", "fireworks"]},
    {"id": "pd.weapon_seen", "v": 1, "category": "weapons", "w": 0.5,
     "any": ["(armed|brandishing)", "(gun|firearm|knife) ... (seen|displayed|involved)"], "not": ["no weapons", "not armed"]},
    {"id": "pd.mva_injury", "v": 1, "category": "mva_injury", "w": 0.65,
     "any": ["(mva|accident|crash|collision) ... (injury|injuries|injured)", "(pedestrian|ped|bicyclist|cyclist) struck", "(car|vehicle) (overturned|rollover|into a building)", "(pin|pinned|trapped) ... (vehicle|car)"],
     "not": ["no injuries", "property damage only", "no injury"]},
    {"id": "pd.mva", "v": 1, "category": "mva_injury", "w": 0.3,
     "any": ["(mva|motor vehicle accident|car accident|crash)"], "not": ["no injuries", "property damage only"]},
    {"id": "pd.barricade", "v": 1, "category": "barricade", "w": 0.75,
     "any": ["(barricaded|barricade)", "(hostage|hostages)", "refusing to (come out|exit)"]},
    {"id": "pd.aided", "v": 1, "category": "aided", "w": 0.6,
     "any": ["(unresponsive|unconscious) (male|female|person|subject)", "not breathing", "(cpr|cardiac arrest) in progress", "(overdose|od) ... (unresponsive|narcan)"]},
    {"id": "pd.gas", "v": 1, "category": "hazmat", "w": 0.6,
     "any": ["(odor|smell) of gas", "gas leak", "(wires|wire) down", "(carbon monoxide|co alarm) ... (sick|symptoms|ill)"], "not": ["no odor"]},
    {"id": "pd.water", "v": 1, "category": "water_rescue", "w": 0.7,
     "any": ["(person|subject|male|female|someone) in the water", "(boat|vessel) (sinking|taking on water|capsized)", "through the ice"]},
    {"id": "pd.pursuit", "v": 1, "category": "pursuit", "w": 0.65,
     "any": ["in pursuit", "(vehicle|car) (pursuit|chase)", "(failed|failing) to (stop|yield)", "foot pursuit"], "not": ["terminate the pursuit", "pursuit terminated"]},
    {"id": "pd.edp", "v": 1, "category": "edp", "w": 0.6,
     "any": ["(edp|emotionally disturbed)", "(suicidal|threatening suicide)", "(jumper|threatening to jump)"]},
    {"id": "pd.fight", "v": 1, "category": "dispute", "w": 0.5,
     "any": ["(fight|brawl) in progress", "(large|big) fight", "(domestic|dispute) ... (in progress|physical)"]},
    {"id": "pd.alarm", "v": 1, "category": "alarm", "w": 0.6,
     "any": ["(fire alarm|smoke alarm|co alarm|carbon monoxide alarm) ... (activation|sounding|going off)", "(commercial|residential) fire alarm"]},
    {"id": "pd.dispatch_cue", "v": 1, "category": "*", "w": 0.2,
     "any": ["respond to", "(vicinity|area) of", "report of", "caller (states|reports|advising)"]},
    {"id": "pd.urgent_cue", "v": 1, "category": "*", "w": 0.15,
     "any": ["(priority|emergency) (call|response)", "(rush|expedite)", "(multiple|several) (calls|callers)"]},
    {"id": "pd.routine", "v": 1, "category": "routine", "w": -0.4,
     "any": ["(traffic stop|parking complaint|noise complaint)", "(lockout|car lockout)", "(test|testing) (one|1) two", "(drill|exercise) only"]}
  ],
  "suppress": ["(disregard|disregarding)", "cancel (that|the call|the response)", "(training|this is a test|for training)"]
}
