{
  "_about": "Police dispatch pre-alerts (sizeup/intel/engine.py). Generic phrases only: no real addresses, names, callsigns or slang (those live in the hub's Settings, never in this public file). Every category pushes to the pre-alert topic from day one (user, 2026-11-12: no shadow week); Settings > System > Intel moves any rule, category or the pack down the ladder off / shadow / log / map / push. fire_call (a burning smell or smoke complaint, the FD being notified: either alone is under the threshold; with the dispatch cue or each other it is over) holds at log until it has a place a crew can drive to in the source's towns (\"place\": true), at most RELEASE_S (5 min) after the call-out: then it pushes without one. Scope: Port Chester / Rye / Rye Brook PD only (dispatch, tac, secure); the other MRRS police talkgroups (Harrison, MTA, interop) are neighbor_police.json, these same rules at log. Barricade: the word alone (\"hostage\", \"barricade\") is under the threshold; with a dispatch cue, a weapon, a standoff, ESU / SWAT / a negotiator, or said as a barricaded subject or a hostage situation it is over.",
  "name": "police",
  "version": 1,
  "domain": "police",
  "label": "PD",
  "scope": {"services": ["police"], "sources": ["p25:mrrs:9211", "p25:mrrs:9212", "p25:mrrs:9213"], "tiers": [], "systems": ["mrrs"]},
  "accept": false,
  "window_s": 120,
  "threshold": 0.6,
  "context_factor": 0.5,
  "mode": "push",
  "towns": {"p25:mrrs:9211": ["Port Chester", "Rye", "Rye Brook"]},
  "categories": {
    "fire_report": {"label": "Smoke / fire reported", "ttl_min": 45, "priority": 4, "mode": "push", "tag": "fire"},
    "fire_call": {"label": "Burning smell / FD notified", "ttl_min": 45, "priority": 4, "mode": "push", "tag": "fire", "place": true, "defer_to": "fire_report",
                  "words": ["smell", "smells", "smelling", "smelled", "smelt", "odor", "odour", "burning", "smoke", "smoky", "flames"]},
    "weapons": {"label": "Weapon / shots", "ttl_min": 90, "priority": 5, "mode": "push", "tag": "warning", "safety": true},
    "mva_injury": {"label": "MVA with injuries", "ttl_min": 45, "priority": 4, "mode": "push", "tag": "car"},
    "barricade": {"label": "Barricade", "ttl_min": 120, "priority": 5, "mode": "push", "tag": "warning", "safety": true,
                  "words": ["barricade", "barricaded", "hostage", "hostages", "standoff", "negotiator", "swat", "esu"]},
    "aided": {"label": "Aided / unresponsive", "ttl_min": 30, "priority": 4, "mode": "push", "tag": "ambulance"},
    "hazmat": {"label": "Gas / hazmat", "ttl_min": 60, "priority": 4, "mode": "push", "tag": "biohazard"},
    "water_rescue": {"label": "Water rescue", "ttl_min": 60, "priority": 5, "mode": "push", "tag": "ocean"},
    "pursuit": {"label": "Pursuit", "ttl_min": 20, "priority": 3, "mode": "push", "tag": "rotating_light", "moves": true},
    "edp": {"label": "EDP", "ttl_min": 60, "priority": 3, "mode": "push", "tag": "warning", "safety": true},
    "dispute": {"label": "Dispute / fight", "ttl_min": 30, "priority": 3, "mode": "push", "tag": "rotating_light", "safety": true},
    "alarm": {"label": "Alarm", "ttl_min": 20, "priority": 2, "mode": "push", "tag": "bell"}
  },
  "rules": [
    {"id": "pd.smoke_seen", "v": 1, "category": "fire_report", "w": 0.7,
     "any": ["smoke ... (from|coming|showing|in the|pouring)", "(car|vehicle|house|dumpster|brush|kitchen|structure|garage) fire", "(flames|fire) (showing|visible|coming)", "fire in the (building|house|apartment|basement)"],
     "not": ["no smoke", "smoke detector", "smoke alarm", "fire department (on scene|is on scene)"]},
    {"id": "pd.smell_smoke", "v": 1, "category": "fire_report", "w": 0.45,
     "any": ["(odor|smell) of smoke", "(odor|smell) ... burning"], "not": ["no odor"]},
    {"id": "pd.fire_complaint", "v": 2, "category": "fire_call", "w": 0.55,
     "any": ["(smell|smells|smelling|smelled|smelt) ... (burning|smoke)", "(odor|odour) of (smoke|burning|something burning)", "burning (smell|odor|odour)", "smoke (smell|odor|odour|condition)", "smoke in the (house|home|residence|apartment|building|hallway|hall|basement|kitchen|room|unit|attic|garage|store)", "(something|plastic|rubber) burning", "(caught|catching) fire", "fire in the (house|home|residence|apartment|building|kitchen|basement|attic|garage|wall|walls)"],
     "not": ["no (smoke|odor|odour|smell|fire)", "(burnt|burned) food", "food on the (stove|oven)", "(firework|fireworks)", "(test|testing|drill) ... (alarm|alarms|detector|detectors)", "(alarm|alarms|detector|detectors) (test|testing|drill)", "(burn|burning) permit", "(bonfire|bon fire|fire pit|firepit|fireplace|chiminea|grill|barbecue|bbq|wood stove|controlled burn)", "(leaf|leaves|brush|yard) burning", "(marijuana|weed|cannabis|cigarette|cigarettes|cigar|vape|vaping)", "re:\\b(people|person|some(one|body)|kids|juveniles|subjects?|(fe)?males?|(wo)?m[ae]n|guys?|drivers?)[^\\w',.;?!]+((is|was|are|were)[^\\w',.;?!]+)?smoking\\b", "smoking (a|weed|cigarettes|cigarette|pot|marijuana)", "burning rubber", "(doing|did|does) (donuts|doughnuts)", "(drifting|peeling out)", "negative (smoke|fire|odor|odour|smell)", "(not|nothing) burning"]},
    {"id": "pd.appliance_smoking", "v": 1, "category": "fire_call", "w": 0.55,
     "any": ["re:\\b(outlets?|wiring|wires?|panel(?![\\s-]+(van|truck)s?\\b))((?:[^\\w'.?!]|\\.(?=\\.)|(?<=\\.)\\.(?!\\.))+(?!(no|not|none|nobody|nothing|negative|zero|never|\\w+n't)\\b)[\\w']+){0,5}(?:[^\\w'.?!]|\\.(?=\\.)|(?<=\\.)\\.(?!\\.))+(smoking|on\\s+fire|burning|sparking)\\b", "re:\\b(appliance|dryer|stove|oven|microwave|toaster)((?:[^\\w'.?!]|\\.(?=\\.)|(?<=\\.)\\.(?!\\.))+(?!(no|not|none|nobody|nothing|negative|zero|never|\\w+n't)\\b)[\\w']+){0,5}(?:[^\\w'.?!]|\\.(?=\\.)|(?<=\\.)\\.(?!\\.))+(smoking|on\\s+fire|burning|sparking)\\b"],
     "not": ["no (smoke|odor|odour|smell|fire)", "(burnt|burned) food", "food on the (stove|oven)", "(firework|fireworks)", "(test|testing|drill) ... (alarm|alarms|detector|detectors)", "(alarm|alarms|detector|detectors) (test|testing|drill)", "(burn|burning) permit", "(bonfire|bon fire|fire pit|firepit|fireplace|chiminea|grill|barbecue|bbq|wood stove|controlled burn)", "(leaf|leaves|brush|yard) burning", "(marijuana|weed|cannabis|cigarette|cigarettes|cigar|vape|vaping)", "re:\\b(people|person|some(one|body)|kids|juveniles|subjects?|(fe)?males?|(wo)?m[ae]n|guys?|drivers?)([^\\w',.;?!]+(?!(says?|said|stat|report|advis|call|tell|told|whose|dryer|stove|oven|microwave|toaster|outlet|wir|panel|applian))[\\w']+){0,5}[^\\w',.;?!]+smoking\\b", "smoking (a|weed|cigarettes|cigarette|pot|marijuana)", "burning rubber", "(doing|did|does) (donuts|doughnuts)", "(drifting|peeling out)", "negative (smoke|fire|odor|odour|smell)", "(not|nothing) burning"]},
    {"id": "pd.fd_notified", "v": 1, "category": "fire_call", "w": 0.4,
     "any": ["(notify|notifying|notified|notifies|alerting|alerted) (the fd|fd|the fire department|fire department|fire)", "(advise|advising|advised) (the fd|fd|the fire department|fire department)", "(fd|fire department) (en route|responding|notified|requested|on the way|dispatched)", "(fd|fire department|fire) (is|are|was|has been|is being|being) (en route|responding|notified|requested|on the way)", "(fd|fire department|fire) (is|has been|is being|being) (dispatched|sent)", "fire (en route|responding|notified)", "(start|send|sending|request|requesting|get|call|calling) (the fd|fd|the fire department|fire department)", "(have|having) (the fd|fd|fire|the fire department) (respond|come|check)"],
     "not": ["(fd|fire department|fire) (on scene|is on scene|cleared|is clear|not needed|is not needed)", "(cancel|canceling|cancelling|disregard) (the fd|fd|fire|the fire department|fire department)", "(don't|do not|doesn't|does not) need (the fd|fd|fire|the fire department|fire department)"]},
    {"id": "pd.shots", "v": 1, "category": "weapons", "w": 0.75,
     "any": ["shots fired", "(shot|shots) ... heard", "(gunshot|gunshots)", "(man|male|female|subject) with a (gun|knife|weapon)", "person shot", "(stabbing|stabbed)"],
     "not": ["no weapons", "fireworks"]},
    {"id": "pd.weapon_seen", "v": 1, "category": "weapons", "w": 0.5,
     "any": ["(armed|brandishing)", "(gun|firearm|knife) ... (seen|displayed|involved)"], "not": ["no weapons", "not armed"]},
    {"id": "pd.mva_injury", "v": 1, "category": "mva_injury", "w": 0.65,
     "any": ["(mva|accident|crash|collision) ... (injury|injuries|injured)", "(pedestrian|ped|bicyclist|cyclist) struck", "(car|vehicle) (overturned|rollover|into a building)", "(pin|pinned|trapped) ... (vehicle|car)"],
     "not": ["no injuries", "property damage only", "no injury"]},
    {"id": "pd.mva", "v": 1, "category": "mva_injury", "w": 0.3,
     "any": ["(mva|motor vehicle accident|car accident|crash)"], "not": ["no injuries", "property damage only"]},
    {"id": "pd.barricade", "v": 2, "category": "barricade", "w": 0.5,
     "any": ["(barricaded|barricade)", "(hostage|hostages)"]},
    {"id": "pd.barricade_said", "v": 1, "category": "barricade", "w": 0.75,
     "any": ["barricaded (subject|person|male|female|suspect|individual|himself|herself|themselves|inside)", "(barricade|hostage) situation", "(holding|holds|held|taken|took|taking) ... (hostage|hostages)", "refusing to (come out|exit)"]},
    {"id": "pd.barricade_cue", "v": 1, "category": "barricade", "w": 0.3,
     "any": ["(standoff|stand off)", "(esu|swat|negotiator|negotiators)", "(emergency service|emergency services|tactical) (unit|team)", "(armed|brandishing)", "with a (gun|knife|weapon|firearm|rifle|shotgun)"],
     "not": ["no weapons", "not armed"]},
    {"id": "pd.aided", "v": 1, "category": "aided", "w": 0.6,
     "any": ["(unresponsive|unconscious) (male|female|person|subject)", "not breathing", "(cpr|cardiac arrest) in progress", "(overdose|od) ... (unresponsive|narcan)"]},
    {"id": "pd.gas", "v": 1, "category": "hazmat", "w": 0.6,
     "any": ["(odor|smell) of gas", "gas leak", "(wires|wire) down", "(carbon monoxide|co alarm) ... (sick|symptoms|ill)"], "not": ["no odor"]},
    {"id": "pd.water", "v": 1, "category": "water_rescue", "w": 0.7,
     "any": ["(person|subject|male|female|someone) in the water", "(boat|vessel) (sinking|taking on water|capsized)", "through the ice"]},
    {"id": "pd.pursuit", "v": 1, "category": "pursuit", "w": 0.65,
     "any": ["in pursuit", "(vehicle|car) (pursuit|chase)", "(failed|failing) to (stop|yield)", "foot pursuit"], "not": ["terminate the pursuit", "pursuit terminated"]},
    {"id": "pd.edp", "v": 1, "category": "edp", "w": 0.6,
     "any": ["(edp|emotionally disturbed)", "(suicidal|threatening suicide)", "(jumper|threatening to jump)"]},
    {"id": "pd.fight", "v": 1, "category": "dispute", "w": 0.5,
     "any": ["(fight|brawl) in progress", "(large|big) fight", "(domestic|dispute) ... (in progress|physical)"]},
    {"id": "pd.alarm", "v": 1, "category": "alarm", "w": 0.6,
     "any": ["(fire alarm|smoke alarm|co alarm|carbon monoxide alarm) ... (activation|sounding|going off)", "(commercial|residential) fire alarm"]},
    {"id": "pd.dispatch_cue", "v": 1, "category": "*", "w": 0.2,
     "any": ["respond to", "(vicinity|area) of", "report of", "caller (states|reports|advising)"]},
    {"id": "pd.urgent_cue", "v": 1, "category": "*", "w": 0.15,
     "any": ["(priority|emergency) (call|response)", "(rush|expedite)", "(multiple|several) (calls|callers)"]},
    {"id": "pd.routine", "v": 1, "category": "routine", "w": -0.4,
     "any": ["(traffic stop|parking complaint|noise complaint)", "(lockout|car lockout)", "(test|testing) (one|1) two", "(drill|exercise) only"]}
  ],
  "suppress": ["(disregard|disregarding)", "cancel (that|the call|the response)", "(training|this is a test|for training)"]
}
