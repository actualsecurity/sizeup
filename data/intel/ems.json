{
  "_about": "EMS traffic as fire pre-alerts (sizeup/intel/engine.py): the calls an engine or a rescue is likely to be sent on, or should know about. LOG ONLY: the pack, every category and every rule start at \"log\" (an event in the store and the log; never the map, the console's card or a push) until an admin raises all three in Settings > System > Intel. Scope: the county P25 system's talkgroups whose service is ems or fire (EMS is dispatched and worked on the Fire/EMS talkgroups) and another system's EMS talkgroups; never a talkgroup number, never our analog fire channels. An ambulance being sent is no signal here (it is every call), so the rules are the patient's state, the crash's mechanism and what is asked of the fire department. Generic phrases only: no real addresses, names, callsigns or slang. Phrases are written in the spelling of data/intel/tables/stt.json. Each strong phrase family is a rule of its own, at or over the threshold alone, so a later change can mark single rules always-alert.",
  "name": "ems",
  "version": 2,
  "order": 2,
  "domain": "ems",
  "label": "EMS",
  "scope": {"services": ["ems", "fire"], "sources": ["p25:westchester:*", "p25:mrrs:*"], "tiers": [], "systems": []},
  "accept": false,
  "window_s": 120,
  "threshold": 0.6,
  "context_factor": 0.5,
  "mode": "log",
  "normalize": "stt",
  "infer": false,
  "towns": {"p25:mrrs:*": ["Port Chester", "Rye", "Rye Brook"]},
  "area": ["Port Chester", "Rye Brook", "Rye", "Harrison", "Purchase", "West Harrison", "Greenwich", "Byram"],
  "categories": {
    "aided": {"label": "EMS: cardiac arrest / unresponsive", "ttl_min": 30, "priority": 4, "mode": "log", "tag": "ambulance"},
    "mva_injury": {"label": "EMS: serious crash", "ttl_min": 45, "priority": 4, "mode": "log", "tag": "car"},
    "mci": {"label": "EMS: multiple patients", "ttl_min": 60, "priority": 4, "mode": "log", "tag": "ambulance"},
    "fd_call": {"label": "EMS: fire dept requested", "ttl_min": 30, "priority": 4, "mode": "log", "tag": "fire_engine"},
    "fire_report": {"label": "EMS: burn / smoke patient", "ttl_min": 45, "priority": 4, "mode": "log", "tag": "fire"},
    "hazmat": {"label": "EMS: exposure / CO / electrical", "ttl_min": 60, "priority": 4, "mode": "log", "tag": "biohazard"},
    "water_rescue": {"label": "EMS: person / vehicle in water", "ttl_min": 60, "priority": 5, "mode": "log", "tag": "ocean"},
    "rescue": {"label": "EMS: elevator / trapped / fall from height", "ttl_min": 45, "priority": 4, "mode": "log", "tag": "sos"},
    "weapons": {"label": "EMS: scene not safe", "ttl_min": 90, "priority": 5, "mode": "log", "tag": "warning", "safety": true}
  },
  "rules": [
    {"id": "ems.cpr", "v": 1, "category": "aided", "w": 0.75, "mode": "log",
     "any": ["cpr in progress", "(starting|started|doing|performing|administering|begin|beginning) cpr", "cpr", "not breathing", "(isn't|stopped|wasn't) breathing", "cardiac arrest", "(no pulse|pulseless)", "(working|worked) (a|the) (code|arrest)"],
     "not": ["cpr (class|training|course|certified)", "(is|now|and) breathing"]},
    {"id": "ems.unresponsive", "v": 2, "category": "aided", "w": 0.65, "mode": "log",
     "any": ["(unresponsive|unconscious)", "(down|collapsed) and not moving", "(unresponsive|unconscious) (male|female|patient|person|party)"],
     "not": ["conscious and (alert|breathing)", "(is|now) (responsive|conscious|awake)", "(now|is) (alert|responding)", "alert and (conscious|oriented)", "conscious and alert", "but now responding"]},
    {"id": "ems.overdose", "v": 1, "category": "aided", "w": 0.6, "mode": "log",
     "any": ["(overdose|overdosed|overdosing)", "narcan", "(possible|apparent|suspected) od"]},
    {"id": "ems.mva_serious", "v": 1, "category": "mva_injury", "w": 0.7, "mode": "log",
     "any": ["(rollover|overturned|rolled over|on its side|on its roof|head on)", "(pedestrian|ped|bicyclist|cyclist|pedestrians) (struck|hit)", "(struck|hit) (a|the) (pedestrian|bicyclist|cyclist)", "(struck|hit) by (a|the) (car|vehicle|truck|bus|train)", "(entrapment|extrication|ejected|ejection)", "(pinned|trapped) ... (vehicle|car|truck|driver|passenger|dashboard)", "(car|vehicle|truck|bus) (into|through|struck|hit) (a|the) (building|house|store|storefront|pole|tree|wall)"],
     "not": ["no injuries", "no injury", "no entrapment"]},
    {"id": "ems.mva_word", "v": 1, "category": "mva_injury", "w": 0.35, "mode": "log",
     "any": ["(mva|motor vehicle accident|car accident|vehicle accident|crash|collision)", "(2|3|4|multi|multiple) (car|vehicle) accident"],
     "not": ["no injuries", "no injury"]},
    {"id": "ems.mva_heavy", "v": 1, "category": "mva_injury", "w": 0.45, "mode": "log",
     "any": ["(heavy|major|significant|severe) (damage|front end damage|intrusion)", "(airbag|airbags) (deployed|deployment)", "(highway|parkway|interstate|high speed)", "(fluids|fuel|gasoline) (leaking|down|on the roadway)", "(lanes|lane|road|roadway) (blocked|closed)"]},
    {"id": "ems.mci", "v": 2, "category": "mci", "w": 0.65, "mode": "log",
     "any": ["(mci|mass casualty)", "(multiple|several|numerous) (patients|victims|injured|casualties)", "re:\\b(three|four|five|six|seven|eight) (patients|victims|injured)\\b"]},
    {"id": "ems.more_ambulances", "v": 2, "category": "mci", "w": 0.5, "mode": "log",
     "any": ["(need|requesting|request|start|send) ... (additional|another|2nd|3rd) (ambulance|als|bls|medic|unit)", "(additional|another|2nd|3rd|more) (ambulance|ambulances|bus|buses|als unit)"],
     "not": ["back in service", "(cancel|canceling|cancelling|cancelled|canceled) ... (ambulance|ambulances)", "mutual aid"]},
    {"id": "ems.fd_requested", "v": 2, "category": "fd_call", "w": 0.6, "mode": "log",
     "any": ["(fire department|fd) (en route|responding|notified|requested|on the way|being notified)", "(fire department|fd) (is|are|was|has been|have been) (en route|responding|notified|requested|on the way)", "(notify|notified|start|send|request|requesting|need|get|call) (the fire department|fire department|the fd|fd)", "(need|requesting|request|start|send) ... (lift assist|manpower|forcible entry|extrication|landing zone)", "(set up|setting up|establish|establishing) (a|the) (landing zone|lz)"],
     "not": ["fire department (on scene|is on scene|cleared|is clear|not needed)", "(cancel|canceling|cancelling) (the fire department|fire|fd)", "(don't|do not) need (the fire department|fire|fd)", "back in service", "lift assist only", "(responding|en route) (to|for|on) (the|a) lift assist"]},
    {"id": "ems.fire_patient", "v": 1, "category": "fire_report", "w": 0.65, "mode": "log",
     "any": ["smoke inhalation", "(burn|burns) (patient|patients|victim|victims|injury|injuries)", "(patient|patients|victim|victims|person|male|female|child) ... (burns|burned|burn injury|out of the fire)", "(patient|patients|victim|victims) from (the|a) fire"],
     "not": ["no (burns|injuries|patients)", "(burnt|burned) food"]},
    {"id": "ems.exposure", "v": 3, "category": "hazmat", "w": 0.65, "mode": "log",
     "any": ["(chemical|hazmat|hazardous|gas|fumes|ammonia|chlorine) (exposure|inhalation)", "(exposed to|overcome by|inhaled) ... (gas|fumes|chemical|chemicals|smoke)", "(multiple|several) (people|patients|persons) (sick|ill|vomiting|dizzy)", "(decon|decontamination) (of|for) (the|a) (patient|patients|victim|victims)"],
     "not": ["no exposure", "gas (truck|crew|company|station)"]},
    {"id": "ems.co", "v": 2, "category": "hazmat", "w": 0.6, "mode": "log",
     "any": ["(carbon monoxide|co) ... (symptoms|sick|headache|headaches|dizzy|nausea|exposure|poisoning|patient|patients)", "(symptoms|sick|headache|headaches|dizzy|nausea|patient|patients) ... (carbon monoxide|co alarm|co detector)"],
     "not": ["no symptoms", "no patients", "no co", "no carbon monoxide", "negative (co|readings)"]},
    {"id": "ems.electrical", "v": 1, "category": "hazmat", "w": 0.6, "mode": "log",
     "any": ["(electrocution|electrocuted)", "(patient|person|victim|worker|male|female) ... (live wire|live wires|power line|power lines)", "(contact|in contact) with ... (wires|wire|power line|power lines)"]},
    {"id": "ems.water", "v": 1, "category": "water_rescue", "w": 0.7, "mode": "log",
     "any": ["(person|subject|male|female|someone|somebody|child|body|man|woman|patient) in the (water|river|pond|lake|sound|harbor)", "(person|subject|male|female|someone|somebody|child|kid|body|man|woman|patient) in the (pool|creek|brook|reservoir)", "(car|vehicle|truck) (in|into) the (water|river|pond|lake|sound|harbor|creek|brook|reservoir)", "(boat|vessel|kayak|canoe) (sinking|taking on water|capsized|overturned|adrift)", "through the ice", "(drowning|drowned|went under|gone under|near drowning)", "(pulled|pulling) ... (from|out of) the (water|river|pond|lake|pool)"],
     "not": ["(no one|no 1|nobody) in the water"]},
    {"id": "ems.elevator", "v": 1, "category": "rescue", "w": 0.6, "mode": "log",
     "any": ["(stuck|trapped|stalled) ... elevator", "elevator ... (stuck|trapped|stalled|entrapment|occupied|occupants|inside)", "elevator (rescue|entrapment|emergency)"],
     "not": ["(unoccupied|empty)", "(no one|no 1|nobody|no occupants) ... (inside|elevator)"]},
    {"id": "ems.trapped", "v": 1, "category": "rescue", "w": 0.6, "mode": "log",
     "any": ["(trapped|pinned|stuck) (under|underneath|beneath|between|in a trench|in the trench|in a machine|in the machine)", "(fell|fall|fallen) ... (from|off) (a|the) (roof|ladder|scaffold|scaffolding|tree|bridge)", "(technical|rope|confined space|high angle) rescue"]},
    {"id": "ems.scene_unsafe", "v": 3, "category": "weapons", "w": 0.7, "mode": "log",
     "any": ["scene (not|is not|isn't) (safe|secure)", "shots fired", "(gunshot|gunshots|gsw)", "(stabbing|stabbed)", "(person|male|female|patient|victim|man|woman) shot", "(wait|waiting|hold|holding) for (pd|police|the police) to (secure|clear|arrive on scene)"],
     "not": ["scene is (safe|secure)", "no weapons"]},
    {"id": "ems.staging", "v": 1, "category": "weapons", "w": 0.45, "mode": "log",
     "any": ["(stage|staging|standby) ... (for pd|for police|until pd|until police|for the police)"],
     "not": ["scene is (safe|secure)", "(pd|police) (on scene|on location) (and|scene is) (safe|secure)"]},
    {"id": "ems.combative", "v": 1, "category": "weapons", "w": 0.5, "mode": "log",
     "any": ["(combative|violent|armed) (patient|person|male|female|subject|party)", "(pd|police) ... (expedite|step it up|rush)", "(need|requesting|request|start|send) (pd|police) ... (expedite|rush|forthwith|now)"],
     "not": ["not (combative|violent|armed)"]},
    {"id": "ems.dispatch_cue", "v": 1, "category": "*", "w": 0.2, "mode": "log",
     "any": ["respond to", "(vicinity|area) of", "report of", "caller (states|reports|advising|says)", "responding to"]},
    {"id": "ems.urgent_cue", "v": 1, "category": "*", "w": 0.15, "mode": "log",
     "any": ["(priority|emergency) (call|response|1)", "(rush|expedite|step it up)", "(multiple|several) (calls|callers)"]},
    {"id": "ems.resolved", "v": 1, "category": "routine", "w": -0.5, "mode": "log",
     "any": ["(refusal|rma|refused|refusing)", "false alarm", "(unfounded|negative results|gone on arrival|goa)", "under control", "(cancel|canceling|cancelling|cancelled|canceled) (ems|the ambulance|fire|the fire department|fd|the call)", "(interfacility|transfer|discharge)", "(earlier|previous|yesterday|last night|last week)"]}
  ],
  "suppress": ["(this is a drill|this is a test|for training|training exercise|drill only|exercise only)"]
}
