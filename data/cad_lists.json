  "_dispatch_wording": [
    "The dispatch, as templates. {department} {units} {location} {type} ('a structure fire')",
    "{type_bare} ('structure fire') {already} {info} {change} {respond} {time} {full} {Full}.",
    "Empty parts drop out with their punctuation. new: a first dispatch; add_on: units added to an",
    "event that already had one ({already}: the units on it by status, from already_statuses);",
    "upgrade: re-dispatch with new information and/or a new type. full_response replaces the",
    "units' names when 'Full department response' is ticked; full_response_kinds = what",
    "'Tick all available PCFD apparatus' ticks (never mutual aid). remarks: the dispatcher's remarks",
    "({remarks}, cleaned up and ending in a period), said before the time out; none, no sentence.",
    "lead_in = {department} (the first words); lead_in_joint when a joint_response department's unit goes",
    "or is already on the event ({joint}: 'Rye Brook'); lead_in_joint_only[town] when only theirs go."
  ],
  "dispatch_wording": {
    "new": "{department}, {units}, respond to {location}, for {type}. {remarks} Time out {time}.",
    "new_no_location": "{department}, {units}, respond for {type}. {remarks} Time out {time}.",
    "add_on": "{department}, {units}, added to the assignment. {already} {location}, {type_bare}. {remarks} Time out {time}.",
    "upgrade": "{department}, upgrade on your last alarm, {location}. {info} {change} {respond} {remarks} Time out {time}.",
    "already_group": "{units} {status}",
    "change_type": "Now {type}.",
    "change_type_full": "Now {type}, {full}.",
    "change_full": "{Full}.",
    "respond": "{units}, respond.",
    "full_response": "full department response",
    "remarks": "Reported: {remarks}",
    "lead_in": "{department}",
    "lead_in_joint": "Port Chester and {joint} Fire",
    "lead_in_joint_only": {"Rye Brook": "Rye Brook Fire"},
    "already_statuses": ["DP", "AK", "RS", "ST", "OL"],
    "full_response_kinds": ["chief", "engine", "ladder", "tower", "rescue", "utility", "marine"]
  },
